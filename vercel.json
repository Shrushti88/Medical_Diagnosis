{
  "functions": {
    "api/index.py": {
      "includeFiles": "model.pkl"
    }
  },
  "rewrites": [
    {
      "source": "/predict",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/docs",
      "destination": "/api/index"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index"
    }
  ]
}
